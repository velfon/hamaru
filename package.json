{
  "name": "hamaru",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "10x10 block puzzle. Cloudflare Workers + autonomous kaizen loop.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velfon/hamaru.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:config && vite build",
    "preview": "vite preview",
    "check": "npm run validate:config && npm run typecheck && npm run lint && npm run i18n:check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sim": "tsx sim/run.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "golden:update": "tsx scripts/golden-update.ts",
    "metrics:pull": "tsx scripts/metrics-pull.ts",
    "experiment:eval": "tsx scripts/experiment-eval.ts",
    "deploy": "npm run validate:config && VITE_APP_VERSION=${GIT_SHA:-dev} vite build && wrangler deploy --var APP_VERSION:${GIT_SHA:-dev}",
    "test:e2e": "playwright test",
    "budget": "tsx scripts/size-budget.ts",
    "cf:types": "wrangler types --strict-vars=false",
    "cf:dev": "npm run build && wrangler dev --port 8787",
    "kaizen:digest": "tsx scripts/kaizen-digest.ts",
    "canary": "tsx scripts/canary.ts",
    "change-class": "tsx scripts/change-class.ts"
  },
  "dependencies": {
    "web-vitals": "6.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}

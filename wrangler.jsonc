{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamaru",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // PR ごとのプレビュー(`wrangler versions upload --preview-alias pr-<n>`)を有効にする。
  // プレビューは `--var TELEMETRY:off` で上げ、本番の指標に混ぜない(docs/02 §11 N-11)。
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "hamaru_events" }],
  // ランキング(docs/08 §4)。スキーマは migrations/、適用は `wrangler d1 migrations apply hamaru --remote`
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamaru",
      "database_id": "41cd9528-8d04-45da-99dd-adf8aa5755ec",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "APP_VERSION": "dev", "TELEMETRY": "on", "LEADERBOARD": "on" },
  "observability": { "enabled": true },
}
